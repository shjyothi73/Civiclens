# CivicLens Backend Environment Configuration
PORT=3001

# Google Gemini API Key
# Get your free key at https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Administrator Authentication & Security
ADMIN_EMAIL=admin@civiclens.gov
ADMIN_PASSWORD=CivicLens@Admin2026!
JWT_SECRET=civiclens-secure-default-signing-key-2026

# Cloud Object Storage (Cloudinary - Optional)
# If provided, images upload directly to Cloudinary cloud CDN
# If left empty, CivicLens automatically stores images securely on the server object store (/uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_PRESET=
